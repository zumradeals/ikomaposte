# ===========================================
# IKOMA Poste - Variables d'environnement
# IKOMA Deploy-Ready v2 — node_server
# ===========================================
# Copier ce fichier en .env et remplir les valeurs

# === Application ===
APP_NAME=ikomaposte

# === Ports ===
# Port interne du container
PORT=3000
# Port exposé sur l'hôte (127.0.0.1 uniquement)
HOST_PORT=3000

# ----- Supabase (Frontend Vite) -----
# URL de votre instance Supabase (sans slash final)
VITE_SUPABASE_URL=http://localhost:8000

# Clé publique (anon key) de Supabase
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# ID du projet Supabase (optionnel, pour référence)
VITE_SUPABASE_PROJECT_ID=local

# ----- Supabase Self-Host -----
# Ces variables sont utilisées par docker-compose Supabase

# URL PostgreSQL interne (pour les migrations)
SUPABASE_DB_URL=postgresql://postgres:your-super-secret-password@localhost:5432/postgres

# Clé service role (accès admin, NE PAS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret JWT pour signer les tokens
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# Mot de passe PostgreSQL
POSTGRES_PASSWORD=your-super-secret-password

# ----- Supabase Auth (optionnel) -----
# Désactiver la confirmation email en dev
# GOTRUE_MAILER_AUTOCONFIRM=true

# ----- Production -----
# Domaine public (pour Caddy/reverse proxy)
# DOMAIN=poste.ikomadigit.com
