{
  "ikoma": {
    "schema_version": "1.0",
    "profile": "node_server"
  },
  "app_slug": "ikomaposte",
  "domain": "poste.ikomadigit.com",
  "git_url": "https://github.com/zumradeals/ikomaposte.git",
  "ref": "main",
  "type": "docker-compose",
  "services": [
    "app"
  ],
  "port": 3000,
  "health": {
    "path": "/health",
    "expected_status": 200
  },
  "supabase": {
    "enabled": true,
    "mode": "self-host"
  },
  "env": {
    "required": [
      "VITE_SUPABASE_URL",
      "VITE_SUPABASE_PUBLISHABLE_KEY"
    ]
  }
}
